// ---- API -------------------------------------------------------------------
app.get("/api/colleges", (req, res) => {
  res.json(colleges);
});

app.get("/api/listings", (req, res) => {
  const { collegeId, type, q, minPrice, maxPrice } = req.query;
  let data = [...listings];
  if (collegeId) data = data.filter((l) => l.collegeId === collegeId);
  if (type) data = data.filter((l) => l.type.toLowerCase() === String(type).toLowerCase());
  if (q) {
    const s = String(q).toLowerCase();
    data = data.filter((l) =>
      l.title.toLowerCase().includes(s) ||
      l.address.toLowerCase().includes(s)
    );
  }
  if (minPrice) data = data.filter((l) => l.price >= Number(minPrice));
  if (maxPrice) data = data.filter((l) => l.price <= Number(maxPrice));
  res.json(data);
});

app.post("/api/listings", (req, res) => {
  const { title, type, price, rating, address, lat, lng, collegeId } = req.body || {};
  if (!title || !type || !price || !address || !lat || !lng) {
    return res.status(400).json({ error: "Missing required fields." });
  }
  const id = `lst_${Date.now()}`;
  const parsed = {
    id,
    title: String(title),
    type: String(type),
    price: Number(price),
    rating: rating ? Number(rating) : null,
    address: String(address),
    lat: Number(lat),
    lng: Number(lng),
    collegeId: collegeId || null,
  };
  listings.push(parsed);
  res.status(201).json(parsed);
});

// ---- Frontend (served from here) -------------------------------------------
app.get("/", (req, res) => {
  res.type("html").send(`
<!DOCTYPE html>
<html lang="en">
<head>
