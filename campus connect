  <script>
    const fmtINR = (n) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(n);
    const haversine = (a, b) => {
      const toRad = (x) => x * Math.PI / 180;
      const R = 6371; // km
      const dLat = toRad(b.lat - a.lat);
      const dLng = toRad(b.lng - a.lng);
      const lat1 = toRad(a.lat);
      const lat2 = toRad(b.lat);
      const h = Math.sin(dLat/2)**2 + Math.cos(lat1)*Math.cos(lat2)*Math.sin(dLng/2)**2;
      return 2 * R * Math.asin(Math.sqrt(h));
    };

    const els = {
      search: document.querySelector('#search'),
      college: document.querySelector('#college'),
      type: document.querySelector('#type'),
      minPrice: document.querySelector('#minPrice'),
      maxPrice: document.querySelector('#maxPrice'),
      apply: document.querySelector('#apply'),
      list: document.querySelector('#list'),
      hint: document.querySelector('#hint'),
      addForm: document.querySelector('#addForm'),
      addFormCollege: null,
    };

    document.getElementById('year').textContent = new Date().getFullYear();

    let state = {
      colleges: [],
      listings: [],
      selectedCollege: null,
      markers: { listings: [], college: null },
      map: null,
    };

    async function fetchJSON(url) {
      const res = await fetch(url);
      if (!res.ok) throw new Error('Failed ' + url);
      return res.json();
    }

    async function load() {
      state.colleges = await fetchJSON('/api/colleges');
      populateCollegeSelects();
      await runSearch();
      setupMap();
    }

    function populateCollegeSelects() {
      // Main filter select
      els.college.innerHTML = '<option value="">Choose college</option>' + state.colleges.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
      // Add-form select
      const addSelect = document.querySelector('#addForm select[name="collegeId"]');
      els.addFormCollege = addSelect;
      addSelect.innerHTML = '<option value="">(Optional) Link to college</option>' + state.colleges.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
    }

    async function runSearch() {
      const params = new URLSearchParams();
      if (els.search.value) params.set('q', els.search.value);
      if (els.college.value) params.set('collegeId', els.college.value);
      if (els.type.value) params.set('type', els.type.value);
      if (els.minPrice.value) params.set('minPrice', els.minPrice.value);
      if (els.maxPrice.value) params.set('maxPrice', els.maxPrice.value);

      state.listings = await fetchJSON('/api/listings?' + params.toString());

      const sel = state.colleges.find(c => c.id === els.college.value) || null;
      state.selectedCollege = sel;

      renderList();
      updateMap();

      const parts = [];
      if (els.search.value) parts.push('search: "' + els.search.value + '"');
      if (els.type.value) parts.push('type: ' + els.type.value);
      if (els.minPrice.value || els.maxPrice.value) parts.push('budget: ' + (els.minPrice.value || 0) + '–' + (els.maxPrice.value || '∞'));
      els.hint.textContent = parts.length ? ('Filters → ' + parts.join(', ')) : '';
    }

    function renderList() {
      const c = state.selectedCollege;
      els.list.innerHTML = state.listings.map((l, idx) => {
        const dist = c ? haversine({lat:c.lat,lng:c.lng}, {lat:l.lat,lng:l.lng}) : null;
        return `
          <div class="border rounded-xl p-3 hover:shadow-sm transition cursor-pointer" data-idx="${idx}">
            <div class="flex items-start justify-between gap-2">
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="font-medium">${l.title}</h3>
                  <span class="badge">${l.type}</span>
                </div>
                <p class="text-sm text-gray-600">${l.address}</p>
                ${c ? `<p class="text-xs text-gray-500 mt-1">~${dist.toFixed(2)} km from <span class="font-medium">${c.name}</span></p>` : ''}
              </div>
              <div class="text-right">
                <div class="font-semibold">${fmtINR(l.price)}</div>
                ${l.rating ? `<div class="text-xs text-emerald-700">★ ${l.rating}</div>` : ''}
              </div>
            </div>
          </div>
        `;
      }).join('') || '<p class="text-sm text-gray-500">No results. Try changing filters.</p>';

      // Hook clicks to focus marker
      els.list.querySelectorAll('[data-idx]').forEach(card => {
        card.addEventListener('click', () => {
          const idx = Number(card.getAttribute('data-idx'));
          const l = state.listings[idx];
          focusListingOnMap(l);
        });
      });
    }

    function setupMap() {
      const india = [22.9734, 78.6569];
      state.map = L.map('map').setView(india, 5);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap'
      }).addTo(state.map);
      updateMap();
    }

    function clearMarkers() {
      state.markers.listings.forEach(m => state.map.removeLayer(m));
      state.markers.listings = [];
      if (state.markers.college) { state.map.removeLayer(state.markers.college); state.markers.college = null; }
    }

    function updateMap() {
      if (!state.map) return;
      clearMarkers();

      // College marker
      if (state.selectedCollege) {
        const c = state.selectedCollege;
        const collegeIcon = L.divIcon({
          className: 'college-icon',
          html: '<div style="background:#4f46e5;color:#fff;border-radius:9999px;padding:6px 10px;font-weight:700;box-shadow:0 2px 6px rgba(0,0,0,0.25)">🎓</div>',
          iconSize: [28, 28],
          iconAnchor: [14, 14]
        });
        state.markers.college = L.marker([c.lat, c.lng], { icon: collegeIcon }).addTo(state.map).bindPopup('<b>' + c.name + '</b><br/>' + c.city + ', ' + c.state);
      }

      // Listing markers
      const bounds = [];
      state.listings.forEach((l) => {
        const m = L.marker([l.lat, l.lng]).addTo(state.map).bindPopup('<b>' + l.title + '</b><br/>' + (l.address||'') + '<br/>' + (l.price ? fmtINR(l.price) : ''));
        state.markers.listings.push(m);
        bounds.push([l.lat, l.lng]);
      });

      if (state.selectedCollege) bounds.push([state.selectedCollege.lat, state.selectedCollege.lng]);

      if (bounds.length) {
        state.map.fitBounds(bounds, { padding: [30, 30] });
      }
    }

    function focusListingOnMap(l) {
      if (!state.map) return;
      state.map.setView([l.lat, l.lng], 15);
    }

    els.apply.addEventListener('click', runSearch);

    // Add form
    els.addForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(els.addForm);
      const body = Object.fromEntries(fd.entries());
      body.price = Number(body.price);
      if (body.rating) body.rating = Number(body.rating);
      body.lat = Number(body.lat);
      body.lng = Number(body.lng);

      const res = await fetch('/api/listings', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
      });
      if (!res.ok) { alert('Failed to add listing'); return; }
      els.addForm.reset();
      await runSearch();
    });

    // Load all
    load();
  </script>
</body>
</html>
  `);
});

app.listen(PORT, () => {
